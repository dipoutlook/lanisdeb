# Production environment example for the VPS deployment
# Copy to .env.production and fill in real values before deployment.

# Frontend
VITE_API_URL=https://example.com

# Backend
PORT=4000
CORS_ORIGIN=https://example.com
DATABASE_URL=postgresql://postgres:CHANGE_ME@db:5432/lanisdeb
ADMIN_PASSWORD=CHANGE_ME
ADMIN_JWT_SECRET=CHANGE_ME
ADMIN_EMAIL=admin@example.com
CUSTOMER_EMAIL=customer@example.com
CUSTOMER_PASSWORD=CHANGE_ME

# AI
AI_PROVIDER=openai
AI_API_KEY=replace_with_real_key
AI_MODEL=gpt-4o-mini
